# 管理画面（/admin）のログインパスワード
ADMIN_PASSWORD=change-me

# 管理セッションの署名に使う秘密鍵（ランダムな長い文字列にしてください）
# 生成例: openssl rand -hex 32
SESSION_SECRET=change-me-too

# ローカルでデータベースに接続する場合、Netlify CLI (netlify dev) を使えば
# 自動的に接続情報が渡されるため、通常はこのファイルへの追記は不要です。
# netlify dev を使わずに `next dev` 単体で動かす場合のみ、
# NETLIFY_DB_URL=postgres://... を設定してください。
